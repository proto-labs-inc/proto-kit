{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/health.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/retire-tunnels.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/post-edit-markers.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/trace-hook.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/auto-publish-turn.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/trace-hook.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/turn-start.mjs\""
          }
        ]
      }
    ]
  }
}
