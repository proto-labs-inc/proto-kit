{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/health.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/telemetry-start.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/tools/hooks/post-edit-markers.mjs\""
          }
        ]
      }
    ]
  }
}
