#!/usr/bin/env node
// The proto CLI shim — thin wrappers over the kit's tools, resolved
// relative to this script so it works from the installed plugin.
//   proto status                          one health line per codebase
//   proto verify <workspace>              data-proto-id marker check
//   proto serve <run-dir> start|stop|status   the run supervisor
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const tool = (name) => fileURLToPath(new URL(`../tools/${name}`, import.meta.url));
const [cmd, ...rest] = process.argv.slice(2);

const run = (name, args) =>
  process.exit(spawnSync(process.execPath, [tool(name), ...args], { stdio: "inherit" }).status ?? 1);

if (cmd === "status") run("health.mjs", []);
if (cmd === "verify" && rest[0]) run("verify-markers.mjs", rest);
if (cmd === "serve" && rest[0] && ["start", "stop", "status"].includes(rest[1]))
  run("supervise.mjs", [rest[1], rest[0]]);

console.error(`usage:
  proto status
  proto verify <workspace>
  proto serve <run-dir> start|stop|status`);
process.exit(1);
